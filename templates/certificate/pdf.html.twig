<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Georgia', serif;
            background: #f5f5f5;
        }

        .certificate {
            width: 297mm;
            height: 210mm;
            background: linear-gradient(135deg, #ffffff 0%, #f0f4ff 100%);
            position: relative;
            margin: 20px auto;
            padding: 40px;
            border: 2px solid #2d5a3d;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        }

        .certificate-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .logo {
            width: 60px;
            height: 60px;
            margin: 0 auto 15px;
            background: linear-gradient(135deg, #2d5a3d, #4a8f5e);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 24px;
        }

        .company-name {
            font-size: 14px;
            color: #666;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .certificate-title {
            font-size: 48px;
            color: #2d5a3d;
            font-weight: bold;
            margin: 20px 0;
            letter-spacing: 2px;
        }

        .certificate-subtitle {
            font-size: 16px;
            color: #555;
            margin-bottom: 30px;
        }

        .certificate-content {
            text-align: center;
            margin: 40px 0;
        }

        .recipient-text {
            font-size: 14px;
            color: #666;
            margin-bottom: 10px;
        }

        .recipient-name {
            font-size: 32px;
            color: #2d5a3d;
            font-weight: bold;
            border-bottom: 2px solid #2d5a3d;
            padding-bottom: 10px;
            margin-bottom: 30px;
        }

        .achievement-text {
            font-size: 14px;
            color: #555;
            line-height: 1.8;
            margin-bottom: 30px;
        }

        .score-section {
            background: rgba(45, 90, 61, 0.05);
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            display: inline-block;
            min-width: 250px;
        }

        .score-label {
            font-size: 12px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .score-value {
            font-size: 28px;
            color: #2d5a3d;
            font-weight: bold;
        }

        .footer-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 50px;
        }

        .certificate-number {
            flex: 1;
        }

        .certificate-number-label {
            font-size: 10px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .certificate-number-value {
            font-size: 12px;
            color: #2d5a3d;
            font-weight: bold;
            margin-top: 5px;
        }

        .qr-code {
            flex: 1;
            text-align: center;
        }

        .qr-code-label {
            font-size: 10px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .qr-code img {
            width: 80px;
            height: 80px;
            border: 1px solid #ddd;
        }

        .date-section {
            flex: 1;
            text-align: right;
        }

        .date-label {
            font-size: 10px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .date-value {
            font-size: 14px;
            color: #2d5a3d;
            font-weight: bold;
            margin-top: 5px;
        }

        .signature-line {
            border-top: 1px solid #333;
            width: 120px;
            margin-top: 10px;
        }

        .signature-section {
            display: flex;
            justify-content: space-between;
            margin-top: 60px;
        }

        .signature {
            text-align: center;
            flex: 1;
        }

        .signature-label {
            font-size: 11px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 5px;
        }

        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 80px;
            color: rgba(45, 90, 61, 0.05);
            font-weight: bold;
            pointer-events: none;
            white-space: nowrap;
        }

        .border-decoration {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            pointer-events: none;
        }

        .border-corner {
            position: absolute;
            width: 30px;
            height: 30px;
            border: 2px solid #2d5a3d;
        }

        .border-corner.tl {
            top: 15px;
            left: 15px;
            border-right: none;
            border-bottom: none;
        }

        .border-corner.tr {
            top: 15px;
            right: 15px;
            border-left: none;
            border-bottom: none;
        }

        .border-corner.bl {
            bottom: 15px;
            left: 15px;
            border-right: none;
            border-top: none;
        }

        .border-corner.br {
            bottom: 15px;
            right: 15px;
            border-left: none;
            border-top: none;
        }
    </style>
</head>
<body>
    <div class="certificate">
        <div class="border-decoration">
            <div class="border-corner tl"></div>
            <div class="border-corner tr"></div>
            <div class="border-corner bl"></div>
            <div class="border-corner br"></div>
        </div>

        <div class="watermark">AGRITECH</div>

        <div class="certificate-header">
            <div class="logo">AG</div>
            <div class="company-name">{{ companyName }}</div>
        </div>

        <div class="certificate-content">
            <div class="certificate-title">Certificate of Completion</div>
            <div class="certificate-subtitle">Smart Agriculture Training Program</div>

            <div class="recipient-text">This certifies that</div>
            <div class="recipient-name">{{ userName }}</div>

            <div class="achievement-text">
                has successfully completed the comprehensive training program<br>
                on Smart Agriculture Mobile Application and IoT Sensors,<br>
                demonstrating proficiency in all key features and operations.
            </div>

            <div class="score-section">
                <div class="score-label">Final Assessment Score</div>
                <div class="score-value">{{ quizScore }}%</div>
            </div>
        </div>

        <div class="footer-section">
            <div class="certificate-number">
                <div class="certificate-number-label">Certificate Number</div>
                <div class="certificate-number-value">{{ certificateNumber }}</div>
            </div>

            <div class="qr-code">
                <div class="qr-code-label">Verify Certificate</div>
                <img src="{{ qrCodeUrl }}" alt="QR Code">
            </div>

            <div class="date-section">
                <div class="date-label">Issued On</div>
                <div class="date-value">{{ generatedAt.format('d M Y') }}</div>
            </div>
        </div>

        <div class="signature-section">
            <div class="signature">
                <div class="signature-line"></div>
                <div class="signature-label">Training Director</div>
            </div>

            <div class="signature">
                <div class="signature-line"></div>
                <div class="signature-label">Chief Technology Officer</div>
            </div>
        </div>
    </div>
</body>
</html>
