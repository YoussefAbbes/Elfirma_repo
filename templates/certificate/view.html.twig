{% extends "base.html.twig" %}

{% block title %}Certificate Verification - AgriTech{% endblock %}

{% block body %}
<div class="container my-5" style="padding-top:110px; padding-bottom:60px;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            {% if isValid %}
                <div class="card border-success">
                    <div class="card-body text-center">
                        <div class="mb-4">
                            <svg class="text-success" width="80" height="80" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M10.854 7.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 9.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            </svg>
                        </div>

                        <h2 class="card-title mb-3">Certificate Verified</h2>

                        <div class="alert alert-success" role="alert">
                            <strong>This certificate is valid and authentic.</strong>
                        </div>

                        <div class="certificate-details mt-4 text-start">
                            <dl class="row">
                                <dt class="col-sm-4">Certificate Number:</dt>
                                <dd class="col-sm-8"><code>{{ certificateNumber }}</code></dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-success">Passed - {{ userProgress.quizScore }}%</span>
                                </dd>

                                <dt class="col-sm-4">Issued Date:</dt>
                                <dd class="col-sm-8">{{ userProgress.certificateGeneratedAt|date('d F Y') }}</dd>

                                <dt class="col-sm-4">Certificate:</dt>
                                <dd class="col-sm-8">
                                    <a href="{{ path('training_certificate_download', {'userId': userProgress.userId}) }}" class="btn btn-sm btn-success">
                                        <i class="fas fa-download"></i> Download PDF
                                    </a>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-danger" role="alert">
                    <strong>Certificate Not Found</strong>
                    <p>The certificate number provided could not be verified in our system.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
