{% extends "base.html.twig" %}

{% block title %}Training Dashboard - AgriTech{% endblock %}

{% block body %}
<style>
    :root {
        --bg-dark: #0a0f1c;
        --card-bg: rgba(20, 27, 45, 0.6);
        --card-border: rgba(255, 255, 255, 0.05);
        --accent-green: #48bb78;
        --accent-purple: #764ba2;
        --accent-blue: #667eea;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        background: var(--bg-dark);
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
        color: var(--text-main);
    }

    h1, h2, h3 { font-family: 'Outfit', sans-serif; }

    .container { max-width: 1200px; margin: 0 auto; padding: 60px 20px; }

    .glass-panel {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .header-dashboard {
        padding: 40px;
        margin-bottom: 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
        animation: fadeInDown 0.8s ease-out;
    }

    @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .header-content h1 { font-size: 36px; font-weight: 700; margin-bottom: 12px; }
    .header-content p { font-size: 18px; max-width: 520px; line-height: 1.6; }

    /* Circular Progress (data-driven via JS) */
    .progress-ring-container { position: relative; width: 120px; height: 120px; flex-shrink: 0; }
    .progress-ring { transform: rotate(-90deg); }
    .progress-ring__circle-bg { fill: none; stroke: rgba(255,255,255,0.25); stroke-width: 8; }
    .progress-ring__circle {
        fill: none;
        stroke: #fde68a;
        stroke-width: 8;
        stroke-linecap: round;
        stroke-dasharray: 314;
        stroke-dashoffset: 314;
        transition: stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .progress-text { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; font-family: 'Outfit', sans-serif; }
    .progress-text .num { font-size: 28px; font-weight: 800; }
    .progress-text .label { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; }

    /* Lesson Grid */
    .lessons-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
        margin-bottom: 60px;
    }

    .lesson-card {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        opacity: 0;
        animation: fadeInUp 0.6s ease-out forwards;
        text-decoration: none;
        color: inherit;
    }

    .lesson-card:nth-child(1) { animation-delay: 0.05s; }
    .lesson-card:nth-child(2) { animation-delay: 0.10s; }
    .lesson-card:nth-child(3) { animation-delay: 0.15s; }
    .lesson-card:nth-child(4) { animation-delay: 0.20s; }
    .lesson-card:nth-child(5) { animation-delay: 0.25s; }
    .lesson-card:nth-child(6) { animation-delay: 0.30s; }
    .lesson-card:nth-child(7) { animation-delay: 0.35s; }
    .lesson-card:nth-child(8) { animation-delay: 0.40s; }
    .lesson-card:nth-child(9) { animation-delay: 0.45s; }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .lesson-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 30px 60px -15px rgba(22, 101, 52, 0.30);
    }

    /* Image banner */
    .card-thumb { position: relative; height: 175px; overflow: hidden; }
    .card-thumb img {
        width: 100%; height: 100%; object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        display: block;
    }
    .lesson-card:hover .card-thumb img { transform: scale(1.08); }
    /* subtle fade at the bottom edge so the banner blends into the card */
    .card-thumb::after {
        content: '';
        position: absolute; left: 0; right: 0; bottom: 0; height: 45%;
        background: linear-gradient(to top, rgba(0,0,0,0.35), transparent);
    }

    /* Solid completed check (its own strong bg => always readable over a photo) */
    .thumb-check {
        position: absolute; top: 12px; right: 12px; z-index: 3;
        width: 34px; height: 34px; border-radius: 50%;
        background: #16a34a; color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; font-weight: 700;
        box-shadow: 0 6px 16px rgba(22, 101, 52, 0.45);
    }
    /* duration chip over the photo, dark backing for contrast */
    .thumb-duration {
        position: absolute; left: 12px; bottom: 12px; z-index: 3;
        background: rgba(0,0,0,0.55); color: #fff;
        padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;
        display: flex; align-items: center; gap: 6px;
        backdrop-filter: blur(4px);
    }

    .card-body { padding: 18px 24px 26px; display: flex; flex-direction: column; flex-grow: 1; }
    .card-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .lesson-number {
        width: 38px; height: 38px; border-radius: 11px;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 17px; flex-shrink: 0;
    }
    .lesson-badge { padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; letter-spacing: 0.4px; }

    .card-body h3 { font-size: 19px; margin-bottom: 10px; line-height: 1.35; }
    .lesson-description { font-size: 14px; line-height: 1.6; margin-bottom: 20px; flex-grow: 1; }

    .card-cta { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
    .btn-start { padding: 10px 22px; border-radius: 8px; font-weight: 600; font-size: 14px; transition: all 0.3s ease; border: none; }
    .lesson-card:hover .btn-start { box-shadow: 0 0 20px rgba(22, 101, 52, 0.35); filter: brightness(1.05); }
    .done-pill { font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 6px; }

    /* Quiz Section */
    .quiz-section { padding: 50px; text-align: center; position: relative; overflow: hidden; }
    .quiz-icon { font-size: 64px; margin-bottom: 20px; }
    .quiz-section h2 { font-size: 32px; margin-bottom: 15px; }
    .quiz-section p { font-size: 16px; margin-bottom: 30px; max-width: 600px; margin-left: auto; margin-right: auto; }
    .quiz-stats { display: flex; justify-content: center; gap: 30px; margin-bottom: 40px; flex-wrap: wrap; }
    .stat-badge { padding: 12px 24px; border-radius: 12px; display: flex; flex-direction: column; gap: 5px; }
    .stat-badge .value { font-size: 20px; font-weight: 700; font-family: 'Outfit', sans-serif; }
    .stat-badge .label { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; }
    .btn-quiz { padding: 18px 40px; border-radius: 12px; font-size: 18px; font-weight: 700; text-decoration: none; display: inline-block; transition: all 0.3s ease; border: none; cursor: pointer; }
    .btn-quiz:hover { transform: translateY(-3px); filter: brightness(1.05); }
    .btn-quiz.locked { background: rgba(22,101,52,0.10) !important; color: #6b7280 !important; box-shadow: none !important; cursor: not-allowed; border: 1px solid rgba(22,101,52,0.18) !important; }
    .btn-quiz.locked:hover { transform: none; }
    .lock-hint { color: #a16207; font-size: 14px; margin-top: 16px; font-weight: 600; }
    .passed-banner { color: #166534; font-size: 16px; margin-top: 18px; font-weight: 700; }

    @media (max-width: 768px) {
        .header-dashboard { flex-direction: column; text-align: center; padding: 30px 20px; }
        .quiz-stats { flex-direction: column; gap: 15px; }
    }
</style>

<div class="container">
    <div class="glass-panel header-dashboard">
        <div class="header-content">
            <h1>Welcome to SmartFarm Training</h1>
            <p>Master precision agriculture with interactive 3D sensors, AI models and real-world farm data. Complete all {{ totalLessons }} lessons to unlock your certification exam.</p>
        </div>
        <div class="progress-ring-container">
            <svg class="progress-ring" width="120" height="120">
                <circle class="progress-ring__circle-bg" cx="60" cy="60" r="50"></circle>
                <circle class="progress-ring__circle" cx="60" cy="60" r="50" data-progress="{{ progressPercentage }}"></circle>
            </svg>
            <div class="progress-text">
                <div class="num">{{ completedCount }}<span style="font-size: 16px; opacity: 0.7;">/{{ totalLessons }}</span></div>
                <div class="label">Done</div>
            </div>
        </div>
    </div>

    <div class="lessons-grid">
        {% for lesson in lessons %}
            {% set isDone = lesson.number in completedLessons %}
            <a href="{{ path('training_lesson_view', { lessonNumber: lesson.number }) }}"
               class="lesson-card glass-panel{{ isDone ? ' status-completed' : '' }}">
                <div class="card-thumb">
                    <img src="{{ asset(lesson.image) }}" alt="{{ lesson.title }}" loading="lazy">
                    {% if isDone %}<div class="thumb-check" title="Completed">✓</div>{% endif %}
                    <div class="thumb-duration">⏱️ {{ lesson.duration }}</div>
                </div>
                <div class="card-body">
                    <div class="card-head">
                        <div class="lesson-number">{{ isDone ? '✓' : lesson.number }}</div>
                        <span class="lesson-badge {{ lesson.badgeClass }}">{{ lesson.badge }}</span>
                    </div>
                    <h3>{{ lesson.title }}</h3>
                    <p class="lesson-description">{{ lesson.description }}</p>
                    <div class="card-cta">
                        {% if isDone %}
                            <span class="done-pill">✓ Completed</span>
                        {% else %}
                            <span class="lesson-badge" style="opacity:0">.</span>
                        {% endif %}
                        <span class="btn-start">{{ isDone ? 'Review' : 'Start Lesson' }}</span>
                    </div>
                </div>
            </a>
        {% endfor %}
    </div>

    <!-- Quiz Section -->
    <div class="glass-panel quiz-section">
        <div class="quiz-icon">🏆</div>
        <h2>Certification Exam</h2>
        <p>Put your knowledge to the test. Pass the final exam to generate your official, verifiable SmartFarm Certificate.</p>

        <div class="quiz-stats">
            <div class="stat-badge">
                <span class="value">30</span>
                <span class="label">Questions</span>
            </div>
            <div class="stat-badge">
                <span class="value">70%</span>
                <span class="label">Passing Score</span>
            </div>
            <div class="stat-badge">
                <span class="value">{{ completedCount }}/{{ totalLessons }}</span>
                <span class="label">Lessons Done</span>
            </div>
        </div>

        {% if passed %}
            <a href="{{ path('training_quiz_index') }}" class="btn-quiz">Review Your Result</a>
            <div class="passed-banner">🎉 You already passed with {{ quizScore }}% — your certificate is ready.</div>
        {% elseif allLessonsCompleted %}
            <a href="{{ path('training_quiz_start') }}" class="btn-quiz">Take the Exam</a>
        {% else %}
            <button class="btn-quiz locked" disabled>🔒 Exam Locked</button>
            <div class="lock-hint">Complete all {{ totalLessons }} lessons to unlock the exam ({{ totalLessons - completedCount }} to go).</div>
        {% endif %}
    </div>
</div>

<script>
    // Animate the progress ring to the real completion percentage.
    document.addEventListener('DOMContentLoaded', function () {
        var circle = document.querySelector('.progress-ring__circle');
        if (!circle) return;
        var pct = parseInt(circle.getAttribute('data-progress'), 10) || 0;
        var circumference = 314; // 2 * PI * r (r = 50)
        requestAnimationFrame(function () {
            circle.style.strokeDashoffset = circumference - (circumference * pct / 100);
        });
    });
</script>
{% include "training/_theme.html.twig" %}
{% endblock %}
