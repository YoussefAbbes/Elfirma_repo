<div class="md:hidden fixed bottom-6 right-6 z-50">
<button class="h-16 w-16 bg-primary text-on-primary rounded-full shadow-2xl flex items-center justify-center">
<span class="material-symbols-outlined text-3xl">add</span>
</button>
</div>
{{ include('elfirma/_nav_routes.html.twig') }}
<!-- Sidebar Collapse Handler (keeps content in sync with the shared sidebar) -->
<script>
    (function() {
        const sidebar = document.querySelector('.elfirma-premium-sidebar');
        const mainContent = document.querySelector('.elfirma-admin-content');
        if (!sidebar || !mainContent) return;

        function updateMargin() {
            if (window.innerWidth <= 768) { mainContent.style.marginLeft = '0'; return; }
            mainContent.style.marginLeft = sidebar.classList.contains('collapsed') ? '90px' : '280px';
        }

        if (localStorage.getItem('sidebar-collapsed') === 'true') {
            sidebar.classList.add('collapsed');
        }
        updateMargin();

        new MutationObserver(updateMargin).observe(sidebar, { attributes: true, attributeFilter: ['class'] });
        window.addEventListener('resize', updateMargin);
    })();
</script>
