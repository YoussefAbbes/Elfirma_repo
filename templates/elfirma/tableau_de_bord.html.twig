</div>
</div>
{% else %}
<p class="text-sm text-on-surface-variant text-center py-4">No active crops to track yet.</p>
{% endfor %}
</div>
</div>
</div>
</div>
</section>
<!-- Footer -->
<footer class="w-full py-8 mt-auto flex flex-col sm:flex-row gap-3 justify-between items-center px-6 lg:px-12 border-t border-outline-variant/15 bg-[#fbfbe2]">
<p class="font-body text-sm tracking-wide text-secondary">Elfirma © 2026</p>
<div class="flex gap-8">
<a class="text-on-surface-variant hover:text-secondary transition-colors text-sm" href="#">Technical Support</a>
<a class="text-on-surface-variant hover:text-secondary transition-colors text-sm" href="#">Legal Notice</a>
<a class="text-on-surface-variant hover:text-secondary transition-colors text-sm" href="#">Privacy</a>
