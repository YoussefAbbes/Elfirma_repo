{% extends "base.html.twig" %}

{% block title %}Lesson 6: NPK Sensors{% endblock %}

{% block body %}
<style>
    :root {
        --bg-dark: #0a0f1c;
        --card-bg: rgba(20, 27, 45, 0.6);
        --card-border: rgba(255, 255, 255, 0.05);
        --accent: #3b82f6; /* Blue for NPK */
        --accent-glow: rgba(59, 130, 246, 0.4);
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
        background: var(--bg-dark); 
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
    }
    
    h1, h2, h3 { font-family: 'Outfit', sans-serif; }

    .top-progress-container {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 4px;
        background: rgba(255,255,255,0.1);
        z-index: 1000;
    }
    .top-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #3b82f6, #06b6d4);
        width: 66.66%; /* Lesson 6/9 */
        box-shadow: 0 0 10px var(--accent-glow);
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 60px 20px; }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        animation: fadeUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    
    .glass-card:nth-child(1) { animation-delay: 0.1s; }
    .glass-card:nth-child(2) { animation-delay: 0.2s; }

    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .lesson-header h1 {
        font-size: 36px;
        margin-bottom: 15px;
        background: linear-gradient(135deg, #fff, #bfdbfe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .meta-tags { display: flex; gap: 15px; margin-bottom: 20px; }
    .tag {
        background: rgba(255,255,255,0.05);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        color: var(--text-muted);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .tag-accent {
        background: rgba(59, 130, 246, 0.15);
        color: #93c5fd;
        border-color: rgba(59, 130, 246, 0.3);
    }

    .model-container {
        width: 100%;
        height: 600px;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        background: #050810;
        border: 1px solid var(--card-border);
        margin: 30px 0;
        box-shadow: inset 0 0 50px rgba(0,0,0,0.8);
    }

    .model-overlay {
        position: absolute;
        top: 20px; left: 20px;
        pointer-events: none;
    }
    .model-title {
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 24px;
        font-weight: 600;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }
    .model-hint {
        color: var(--text-muted);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 5px;
    }
    .hint-icon {
        background: rgba(255,255,255,0.1);
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 12px;
    }

    .content-area h2 { color: #fff; font-size: 24px; margin: 30px 0 15px; }
    .content-area p { color: var(--text-muted); margin-bottom: 15px; font-size: 16px; }
    
    .npk-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 30px 0;
    }
    .npk-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--card-border);
        padding: 24px;
        border-radius: 16px;
        transition: transform 0.3s;
    }
    .npk-card:hover { transform: translateY(-5px); background: rgba(255,255,255,0.05); }
    .npk-icon {
        width: 40px; height: 40px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: bold; font-size: 20px; margin-bottom: 15px; color: #fff;
    }

    .highlight-box {
        background: linear-gradient(90deg, rgba(59,130,246,0.1), transparent);
        border-left: 4px solid var(--accent);
        padding: 20px;
        border-radius: 0 12px 12px 0;
        margin: 25px 0;
    }
    .highlight-box strong { color: #fff; }

    .navigation { display: flex; justify-content: space-between; gap: 20px; margin-top: 40px; }
    .btn {
        padding: 16px 32px; border-radius: 12px; font-weight: 600; text-decoration: none;
        text-align: center; transition: all 0.3s; cursor: pointer; border: none; font-size: 16px;
    }
    .btn-prev { background: rgba(255,255,255,0.05); color: #fff; border: 1px solid var(--card-border); }
    .btn-prev:hover { background: rgba(255,255,255,0.1); }
    .btn-complete { background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; flex-grow: 1; }
    .btn-complete:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(59,130,246,0.6); }
    .btn-next { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
    .btn-next:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(102,126,234,0.6); }

    @media (max-width: 768px) { .npk-grid { grid-template-columns: 1fr; } .navigation { flex-direction: column; } .model-container { height: 400px; } }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="/js/three-sensor-models.js"></script>

<div class="top-progress-container"><div class="top-progress-fill"></div></div>

<div class="container">
    <div class="glass-card lesson-header">
        <div class="meta-tags">
            <span class="tag">⏱️ 20 min read</span>
            <span class="tag">📈 Level: Advanced</span>
            <span class="tag tag-accent">✨ 3D Interactive</span>
        </div>
        <h1>NPK Macronutrient Sensors</h1>
        <p style="color: var(--text-muted); font-size: 18px;">Automate fertilizer management by understanding the big three macronutrients: Nitrogen, Phosphorus, and Potassium.</p>
        <img class="lesson-hero" src="{{ asset('images/lessons/lesson6.jpg') }}" alt="Fertilising a crop field">
    </div>

    <div class="glass-card content-area">
        <div id="model-viewer" class="model-container" data-sensor="npk">
            <div class="model-overlay">
                <div class="model-title">Multi-Probe NPK Sensor</div>
                <div class="model-hint">
                    <span class="hint-icon">🖱️ Drag to rotate</span>
                    <span class="hint-icon">⚙️ Scroll to zoom</span>
                </div>
            </div>
        </div>

        <h2>The Big Three</h2>
        <div class="npk-grid">
            <div class="npk-card">
                <div class="npk-icon" style="background:#ef4444;">N</div>
                <h3 style="color:#fff; margin-bottom:10px;">Nitrogen</h3>
                <p style="font-size:14px;">Drives vegetative growth, leaf production, and chlorophyll creation. Deficiency causes yellowing (chlorosis) of older leaves.</p>
            </div>
            <div class="npk-card">
                <div class="npk-icon" style="background:#10b981;">P</div>
                <h3 style="color:#fff; margin-bottom:10px;">Phosphorus</h3>
                <p style="font-size:14px;">Essential for energy transfer (ATP), root development, and flowering. Deficiency leads to stunted growth and purple-tinted leaves.</p>
            </div>
            <div class="npk-card">
                <div class="npk-icon" style="background:#3b82f6;">K</div>
                <h3 style="color:#fff; margin-bottom:10px;">Potassium</h3>
                <p style="font-size:14px;">Regulates water pressure (stomata), disease resistance, and fruit quality. Deficiency causes brown scorching on leaf edges.</p>
            </div>
        </div>

        <div class="highlight-box">
            <strong>💡 Growth Stage Adjustment:</strong> Plants need different NPK ratios as they age. Young plants need high Nitrogen for leaves. When flowering starts, they need high Phosphorus. When fruiting, they need high Potassium.
        </div>
        <div class="knowledge-check"
             data-ok="<strong>Correct!</strong> Nitrogen drives foliage and chlorophyll; a shortage yellows the older leaves first."
             data-no="<strong>Not quite.</strong> Nitrogen (N) is the main driver of green, leafy growth.">
            <h3>🧠 Quick Knowledge Check</h3>
            <p>Which macronutrient most drives leafy, green vegetative growth?</p>
            <div class="options">
                <button class="option-btn" onclick="checkAnswer(this, false)">A. Phosphorus (P).</button>
                <button class="option-btn" onclick="checkAnswer(this, false)">B. Potassium (K).</button>
                <button class="option-btn" data-correct="1" onclick="checkAnswer(this, true)">C. Nitrogen (N).</button>
            </div>
            <div class="feedback"></div>
        </div>
    </div>

    <div class="navigation">
        <a href="/training/lesson/5" class="btn btn-prev">← Previous</a>
        <button class="btn btn-complete" onclick="completeLesson(6, this)">
            <span class="btn-text">✓ Mark as Complete</span>
        </button>
        <a href="/training/lesson/7" class="btn btn-next">Next Lesson →</a>
    </div>
</div>

<script>
    function completeLesson(lessonNumber, btn) {
        const btnText = btn.querySelector('.btn-text');
        btnText.innerText = 'Saving...';
        
        fetch(`/training/lesson/complete/${lessonNumber}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                btnText.innerText = 'Completed! 🎉';
                btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
                setTimeout(() => window.location.href = `/training/lesson/${lessonNumber + 1}`, 1000);
            })
            .catch(err => {
                console.error('Error:', err);
                btnText.innerText = 'Error saving';
            });
    }
</script>
{% include "training/_theme.html.twig" %}
{% endblock %}
