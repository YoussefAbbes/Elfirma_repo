{% extends "base.html.twig" %}

{% block title %}Lesson 7: Plant Disease Detection Using AI{% endblock %}

{% block body %}
<style>
    :root {
        --bg-dark: #0a0f1c;
        --card-bg: rgba(20, 27, 45, 0.6);
        --card-border: rgba(255, 255, 255, 0.05);
        --accent: #a855f7; /* Purple for AI */
        --accent-glow: rgba(168, 85, 247, 0.4);
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
        background: var(--bg-dark); 
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
    }
    
    h1, h2, h3 { font-family: 'Outfit', sans-serif; }

    .top-progress-container {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 4px;
        background: rgba(255,255,255,0.1);
        z-index: 1000;
    }
    .top-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #a855f7, #ec4899);
        width: 77.77%; /* Lesson 7/9 */
        box-shadow: 0 0 10px var(--accent-glow);
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 60px 20px; }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        animation: fadeUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    
    .glass-card:nth-child(1) { animation-delay: 0.1s; }
    .glass-card:nth-child(2) { animation-delay: 0.2s; }

    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .lesson-header h1 {
        font-size: 36px;
        margin-bottom: 15px;
        background: linear-gradient(135deg, #fff, #e9d5ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .meta-tags { display: flex; gap: 15px; margin-bottom: 20px; }
    .tag {
        background: rgba(255,255,255,0.05);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        color: var(--text-muted);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .tag-accent {
        background: rgba(168, 85, 247, 0.15);
        color: #d8b4fe;
        border-color: rgba(168, 85, 247, 0.3);
    }

    .model-container {
        width: 100%;
        height: 600px;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        background: #050810;
        border: 1px solid var(--card-border);
        margin: 30px 0;
        box-shadow: inset 0 0 50px rgba(0,0,0,0.8);
    }

    .model-overlay {
        position: absolute;
        top: 20px; left: 20px;
        pointer-events: none;
    }
    .model-title {
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 24px;
        font-weight: 600;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .content-area h2 { color: #fff; font-size: 24px; margin: 30px 0 15px; }
    .content-area p { color: var(--text-muted); margin-bottom: 15px; font-size: 16px; }
    .content-area ul { list-style: none; margin-bottom: 20px; }
    .content-area li {
        color: var(--text-muted);
        margin-bottom: 10px;
        padding-left: 24px;
        position: relative;
    }
    .content-area li::before {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--accent);
    }

    .highlight-box {
        background: linear-gradient(90deg, rgba(168,85,247,0.1), transparent);
        border-left: 4px solid var(--accent);
        padding: 20px;
        border-radius: 0 12px 12px 0;
        margin: 25px 0;
    }
    .highlight-box strong { color: #fff; }

    .navigation { display: flex; justify-content: space-between; gap: 20px; margin-top: 40px; }
    .btn {
        padding: 16px 32px; border-radius: 12px; font-weight: 600; text-decoration: none;
        text-align: center; transition: all 0.3s; cursor: pointer; border: none; font-size: 16px;
    }
    .btn-prev { background: rgba(255,255,255,0.05); color: #fff; border: 1px solid var(--card-border); }
    .btn-prev:hover { background: rgba(255,255,255,0.1); }
    .btn-complete { background: linear-gradient(135deg, #a855f7, #7e22ce); color: white; flex-grow: 1; }
    .btn-complete:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(168,85,247,0.6); }
    .btn-next { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
    .btn-next:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(102,126,234,0.6); }

    @media (max-width: 768px) { .navigation { flex-direction: column; } .model-container { height: 400px; } }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="/js/three-sensor-models.js"></script>

<div class="top-progress-container"><div class="top-progress-fill"></div></div>

<div class="container">
    <div class="glass-card lesson-header">
        <div class="meta-tags">
            <span class="tag">⏱️ 22 min read</span>
            <span class="tag">📈 Level: Advanced</span>
            <span class="tag tag-accent">🤖 AI Integration</span>
        </div>
        <h1>Plant Disease Detection Using AI</h1>
        <p style="color: var(--text-muted); font-size: 18px;">Leverage convolutional neural networks (CNNs) to instantly identify crop diseases from smartphone photos.</p>
        <img class="lesson-hero" src="{{ asset('images/lessons/lesson7.jpg') }}" alt="Diseased plant leaf close-up">
    </div>

    <div class="glass-card content-area">
        <div id="model-viewer" class="model-container" data-sensor="disease">
            <div class="model-overlay">
                <div class="model-title">AI Leaf Scanning Simulation</div>
            </div>
        </div>

        <h2>How Computer Vision Works in Agriculture</h2>
        <p>The SmartFarm app uses a trained machine learning model that analyzes the pixels in an uploaded leaf photo. It looks for patterns, discolorations, and geometric anomalies associated with specific fungal, bacterial, or viral infections.</p>

        <div class="highlight-box">
            <strong>💡 Best Practice for Photos:</strong> To get accurate AI results, ensure the leaf is well-lit (no harsh shadows), in focus, and isolated. A blurry or backlit photo will drastically lower the AI's confidence score.
        </div>

        <h2>Understanding Confidence Scores</h2>
        <ul>
            <li><strong>90% - 100%:</strong> High certainty. Proceed with the recommended treatment immediately.</li>
            <li><strong>70% - 89%:</strong> Probable match. Monitor the plant closely and check for secondary symptoms.</li>
            <li><strong>< 70%:</strong> Low certainty. The photo might be poor quality, or it's an early-stage/rare disease. Retake the photo.</li>
        </ul>

        <h2>Common Detectable Diseases</h2>
        <p>Our model is highly trained to spot:</p>
        <ul>
            <li>Powdery Mildew (White fungal spots)</li>
            <li>Late Blight (Brown lesions with pale halos)</li>
            <li>Leaf Rust (Orange/brown pustules)</li>
            <li>Nutrient Deficiencies (often misdiagnosed as disease, but the AI can distinguish the chlorosis patterns)</li>
        </ul>
        <div class="knowledge-check"
             data-ok="<strong>Correct!</strong> Clear, well-lit close-ups give the model the detail it needs for a high confidence score."
             data-no="<strong>Not quite.</strong> Use a clear, well-lit close-up of the affected area.">
            <h3>🧠 Quick Knowledge Check</h3>
            <p>What gives the AI the most reliable leaf diagnosis?</p>
            <div class="options">
                <button class="option-btn" onclick="checkAnswer(this, false)">A. A blurry photo taken from far away.</button>
                <button class="option-btn" data-correct="1" onclick="checkAnswer(this, true)">B. A clear, well-lit close-up of the affected area.</button>
                <button class="option-btn" onclick="checkAnswer(this, false)">C. A dark photo with heavy flash glare.</button>
            </div>
            <div class="feedback"></div>
        </div>
    </div>

    <div class="navigation">
        <a href="/training/lesson/6" class="btn btn-prev">← Previous</a>
        <button class="btn btn-complete" onclick="completeLesson(7, this)">
            <span class="btn-text">✓ Mark as Complete</span>
        </button>
        <a href="/training/lesson/8" class="btn btn-next">Next Lesson →</a>
    </div>
</div>

<script>
    function completeLesson(lessonNumber, btn) {
        const btnText = btn.querySelector('.btn-text');
        btnText.innerText = 'Saving...';
        
        fetch(`/training/lesson/complete/${lessonNumber}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                btnText.innerText = 'Completed! 🎉';
                btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
                setTimeout(() => window.location.href = `/training/lesson/${lessonNumber + 1}`, 1000);
            })
            .catch(err => {
                console.error('Error:', err);
                btnText.innerText = 'Error saving';
            });
    }
</script>
{% include "training/_theme.html.twig" %}
{% endblock %}
