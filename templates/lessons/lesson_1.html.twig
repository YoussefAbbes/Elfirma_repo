{% extends "base.html.twig" %}

{% block title %}Lesson 1: Introduction to Smart Agriculture{% endblock %}

{% block body %}
<style>
    :root {
        --bg-dark: #0a0f1c;
        --card-bg: rgba(20, 27, 45, 0.6);
        --card-border: rgba(255, 255, 255, 0.05);
        --accent: #10b981; /* Emerald green */
        --accent-glow: rgba(16, 185, 129, 0.4);
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
        background: var(--bg-dark); 
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
    }
    
    h1, h2, h3 { font-family: 'Outfit', sans-serif; }

    .top-progress-container {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 4px;
        background: rgba(255,255,255,0.1);
        z-index: 1000;
    }
    .top-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #10b981, #34d399);
        width: 11.11%; /* Lesson 1/9 */
        box-shadow: 0 0 10px var(--accent-glow);
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 60px 20px; }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        animation: fadeUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    
    .glass-card:nth-child(1) { animation-delay: 0.1s; }
    .glass-card:nth-child(2) { animation-delay: 0.2s; }

    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .lesson-header h1 {
        font-size: 36px;
        margin-bottom: 15px;
        background: linear-gradient(135deg, #fff, #a7f3d0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .meta-tags { display: flex; gap: 15px; margin-bottom: 20px; }
    .tag {
        background: rgba(255,255,255,0.05);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        color: var(--text-muted);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .tag-accent {
        background: rgba(16, 185, 129, 0.15);
        color: #6ee7b7;
        border-color: rgba(16, 185, 129, 0.3);
    }

    .content-area h2 { color: #fff; font-size: 24px; margin: 30px 0 15px; }
    .content-area p { color: var(--text-muted); margin-bottom: 15px; font-size: 16px; }
    .content-area ul { list-style: none; margin-bottom: 20px; }
    .content-area li {
        color: var(--text-muted);
        margin-bottom: 10px;
        padding-left: 24px;
        position: relative;
    }
    .content-area li::before {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--accent);
    }

    .highlight-box {
        background: linear-gradient(90deg, rgba(16,185,129,0.1), transparent);
        border-left: 4px solid var(--accent);
        padding: 20px;
        border-radius: 0 12px 12px 0;
        margin: 25px 0;
    }
    .highlight-box strong { color: #fff; }

    .grid-benefits {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin: 30px 0;
    }
    .benefit-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--card-border);
        padding: 24px;
        border-radius: 16px;
        transition: transform 0.3s;
    }
    .benefit-card:hover { transform: translateY(-5px); background: rgba(255,255,255,0.05); }
    .benefit-icon { font-size: 32px; margin-bottom: 15px; }
    .benefit-card h3 { color: #fff; margin-bottom: 10px; font-size: 18px; }
    .benefit-card p { font-size: 14px; margin-bottom: 0; }

    .navigation { display: flex; justify-content: flex-end; gap: 20px; margin-top: 40px; }
    .btn {
        padding: 16px 32px; border-radius: 12px; font-weight: 600; text-decoration: none;
        text-align: center; transition: all 0.3s; cursor: pointer; border: none; font-size: 16px;
    }
    .btn-complete { background: linear-gradient(135deg, #10b981, #059669); color: white; flex-grow: 1; }
    .btn-complete:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(16,185,129,0.6); }
    .btn-next { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
    .btn-next:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(102,126,234,0.6); }

    @media (max-width: 768px) { .navigation { flex-direction: column; } }
</style>

<div class="top-progress-container"><div class="top-progress-fill"></div></div>

<div class="container">
    <div class="glass-card lesson-header">
        <div class="meta-tags">
            <span class="tag">⏱️ 15 min read</span>
            <span class="tag">📈 Level: Beginner</span>
            <span class="tag tag-accent">📚 Theory</span>
        </div>
        <h1>Introduction to Smart Agriculture</h1>
        <p style="color: var(--text-muted); font-size: 18px;">Discover how precision agriculture, IoT sensors, and AI are transforming modern farming.</p>
        <img class="lesson-hero" src="{{ asset('images/lessons/lesson1.jpg') }}" alt="Smart agriculture field">
    </div>

    <div class="glass-card content-area">
        <h2>What is Precision Agriculture?</h2>
        <p>Precision agriculture, also known as smart farming, is an approach to farm management using modern technology to ensure profitability, sustainability, and protection of the environment. Rather than applying a blanket treatment to an entire field, smart farming involves analyzing data to target specific areas with exactly what they need.</p>

        <div class="highlight-box">
            <strong>💡 Key Concept:</strong> Smart agriculture combines traditional farming knowledge with cutting-edge technology like IoT sensors and cloud computing to create a sustainable, efficient farming ecosystem.
        </div>

        <h2>Core Benefits of the SmartFarm Platform</h2>
        
        <div class="grid-benefits">
            <div class="benefit-card">
                <div class="benefit-icon">📈</div>
                <h3>Increased Yield</h3>
                <p>Optimize resource use to grow more crops with fewer inputs by understanding exact plant needs.</p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon">💧</div>
                <h3>Water Conservation</h3>
                <p>Reduce water usage by up to 40% through targeted, data-driven irrigation schedules.</p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon">🌍</div>
                <h3>Eco-Friendly</h3>
                <p>Minimize chemical runoff and protect local ecosystems by applying fertilizers only when required.</p>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon">📱</div>
                <h3>Real-time Tracking</h3>
                <p>Monitor your entire farm 24/7 from your smartphone with automated alerts.</p>
            </div>
        </div>

        <h2>What You'll Master in this Course</h2>
        <ul>
            <li>Navigating the mobile application and dashboards.</li>
            <li>Interpreting data from Soil Humidity, Temperature, pH, and NPK sensors.</li>
            <li>Detecting plant diseases using AI image scanning.</li>
            <li>Applying automated AI recommendations to your daily workflow.</li>
        </ul>
        <div class="knowledge-check"
             data-ok="<strong>Correct!</strong> Precision agriculture targets inputs using data instead of one-size-fits-all treatment."
             data-no="<strong>Not quite.</strong> The core idea is data-driven, site-specific decisions — the highlighted answer.">
            <h3>🧠 Quick Knowledge Check</h3>
            <p>What is the core idea behind precision agriculture?</p>
            <div class="options">
                <button class="option-btn" onclick="checkAnswer(this, false)">A. Apply the same treatment evenly across the whole field.</button>
                <button class="option-btn" data-correct="1" onclick="checkAnswer(this, true)">B. Use data to give each part of the field exactly what it needs.</button>
                <button class="option-btn" onclick="checkAnswer(this, false)">C. Stop using technology and farm entirely by hand.</button>
            </div>
            <div class="feedback"></div>
        </div>
    </div>

    <div class="navigation">
        <button class="btn btn-complete" onclick="completeLesson(1, this)">
            <span class="btn-text">✓ Mark as Complete</span>
        </button>
        <a href="/training/lesson/2" class="btn btn-next">Next Lesson →</a>
    </div>
</div>

<script>
    function completeLesson(lessonNumber, btn) {
        const btnText = btn.querySelector('.btn-text');
        btnText.innerText = 'Saving...';
        
        fetch(`/training/lesson/complete/${lessonNumber}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                btnText.innerText = 'Completed! 🎉';
                btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
                setTimeout(() => window.location.href = `/training/lesson/${lessonNumber + 1}`, 1000);
            })
            .catch(err => {
                console.error('Error:', err);
                btnText.innerText = 'Error saving';
            });
    }
</script>
{% include "training/_theme.html.twig" %}
{% endblock %}
