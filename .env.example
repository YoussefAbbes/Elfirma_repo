# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Put real values in .env.local (gitignored) for local dev, or in the server's
# environment / `composer dump-env prod` for production.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_a_random_32_byte_hex
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Use a dedicated DB user with a strong password. Never deploy with root/no-password.
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/personne?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=
MAILER_FROM=
# Optional secondary transport used for some transactional emails.
MAILER_DSN_OTHER=
# Sender address to use with MAILER_DSN_OTHER when it is a Gmail SMTP account.
MAILER_FROM_OTHER=
###< symfony/mailer ###

###> firebase ###
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URI=
###< firebase ###

###> third-party APIs (set real values in .env.local) ###
PIXABAY_API_KEY=
TREFLE_API_KEY=
PROFANITY_FILTER_API_KEY=
# api-ninjas.com (public-holiday check for maintenance scheduling, image-to-text)
API_NINJAS_KEY=
# Cloudflare Workers AI (equipment image generation)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ZOHO_MEETING_EMAIL=
ZOHO_MEETING_PASSWORD=
RESEND_API_BASE_URL=https://api.resend.com
RESEND_API_KEY=
MAPTILER_API_KEY=
TRIPO3D_API_KEY=
TRIPO3D_API_BASE_URL=https://api.tripo3d.ai
TRIPO3D_TIMEOUT=180
USDA_API_KEY=
EXCHANGE_RATE_API_KEY=
OPENWEATHER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Local LM Studio server used by the /api/chatbot assistant
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
###< third-party APIs ###

###> Twilio ###
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_PHONE=
TWILIO_TO_PHONE=
# Keep TLS verification ON in production.
TWILIO_SSL_VERIFY=1
###< Twilio ###

###> capacity alerts ###
CAPACITY_ALERT_THRESHOLD_PERCENT=85
CAPACITY_ALERT_TO_EMAIL=
CAPACITY_ALERT_FROM_EMAIL=
CAPACITY_ALERT_SSL_VERIFY=1
###< capacity alerts ###

###> OAuth (Google / GitHub) ###
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
###< OAuth ###

###> reCAPTCHA ###
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
###< reCAPTCHA ###

###> Stripe ###
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=eur
###< Stripe ###

###> RAG / ML / Face ID (local tooling paths) ###
RAG_PYTHON_PATH=.venv\\Scripts\\python.exe
RAG_CHAT_ENGINE_PATH=rag/scripts/chat_engine.py
RAG_DEFAULT_TOP_K=5
RAG_PROCESS_TIMEOUT=60
RAG_ENABLE_LLM=1
RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-flash-latest
RAG_LLM_TIMEOUT_SECONDS=20
RAG_LLM_MAX_OUTPUT_TOKENS=1800
FACE_ID_PYTHON_BIN=scripts/faceid/.venv/Scripts/python.exe
FACE_ID_HOST=127.0.0.1
FACE_ID_PORT=8765
FACE_ID_THRESHOLD=0.28
# Shared secret between Symfony and the Face ID service (required when the
# service is not bound to localhost, e.g. on Railway). Set the same value on both.
FACE_ID_API_TOKEN=
###< RAG / ML / Face ID ###

###> deployment URLs ###
# Public, externally reachable base URL of the site (no trailing slash). Used to
# build absolute links such as QR codes scanned on phones. In production set this
# to your real domain, e.g. https://elfirma.example.com
APP_PUBLIC_BASE_URL=
# Base URL of the Python AI/chatbot/analytics service (FastAPI). Defaults to the
# local dev service; point this at wherever that service runs in production.
AI_FASTAPI_BASE_URL=http://localhost:8002
###< deployment URLs ###
