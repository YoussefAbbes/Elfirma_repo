{% extends "base.html.twig" %}

{% block title %}Lesson 5: Soil pH Sensors{% endblock %}

{% block body %}
<style>
    :root {
        --bg-dark: #0a0f1c;
        --card-bg: rgba(20, 27, 45, 0.6);
        --card-border: rgba(255, 255, 255, 0.05);
        --accent: #d946ef; /* Fuchsia for pH */
        --accent-glow: rgba(217, 70, 239, 0.4);
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
        background: var(--bg-dark); 
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
    }
    
    h1, h2, h3 { font-family: 'Outfit', sans-serif; }

    .top-progress-container {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 4px;
        background: rgba(255,255,255,0.1);
        z-index: 1000;
    }
    .top-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #d946ef, #a855f7);
        width: 55.55%; /* Lesson 5/9 */
        box-shadow: 0 0 10px var(--accent-glow);
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 60px 20px; }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        animation: fadeUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    
    .glass-card:nth-child(1) { animation-delay: 0.1s; }
    .glass-card:nth-child(2) { animation-delay: 0.2s; }
    .glass-card:nth-child(3) { animation-delay: 0.3s; }

    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .lesson-header h1 {
        font-size: 36px;
        margin-bottom: 15px;
        background: linear-gradient(135deg, #fff, #f5d0fe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .meta-tags { display: flex; gap: 15px; margin-bottom: 20px; }
    .tag {
        background: rgba(255,255,255,0.05);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        color: var(--text-muted);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .tag-accent {
        background: rgba(217, 70, 239, 0.15);
        color: #f0abfc;
        border-color: rgba(217, 70, 239, 0.3);
    }

    .model-container {
        width: 100%;
        height: 600px;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        background: #050810;
        border: 1px solid var(--card-border);
        margin: 30px 0;
        box-shadow: inset 0 0 50px rgba(0,0,0,0.8);
    }

    .model-overlay {
        position: absolute;
        top: 20px; left: 20px;
        pointer-events: none;
    }
    .model-title {
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 24px;
        font-weight: 600;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }
    .model-hint {
        color: var(--text-muted);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 5px;
    }
    .hint-icon {
        background: rgba(255,255,255,0.1);
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 12px;
    }

    .content-area h2 { color: #fff; font-size: 24px; margin: 30px 0 15px; }
    .content-area p { color: var(--text-muted); margin-bottom: 15px; font-size: 16px; }
    .content-area ul { list-style: none; margin-bottom: 20px; }
    .content-area li {
        color: var(--text-muted);
        margin-bottom: 10px;
        padding-left: 24px;
        position: relative;
    }
    .content-area li::before {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--accent);
    }

    .highlight-box {
        background: linear-gradient(90deg, rgba(217,70,239,0.1), transparent);
        border-left: 4px solid var(--accent);
        padding: 20px;
        border-radius: 0 12px 12px 0;
        margin: 25px 0;
    }
    .highlight-box strong { color: #fff; }

    .ph-scale {
        display: flex;
        height: 40px;
        border-radius: 20px;
        overflow: hidden;
        margin: 30px 0 10px;
        border: 1px solid var(--card-border);
    }
    .ph-block { flex: 1; display: flex; align-items: center; justify-content: center; font-weight: bold; color: rgba(0,0,0,0.5); }
    .ph-labels { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted); margin-bottom: 30px; }

    .navigation { display: flex; justify-content: space-between; gap: 20px; margin-top: 40px; }
    .btn {
        padding: 16px 32px; border-radius: 12px; font-weight: 600; text-decoration: none;
        text-align: center; transition: all 0.3s; cursor: pointer; border: none; font-size: 16px;
    }
    .btn-prev { background: rgba(255,255,255,0.05); color: #fff; border: 1px solid var(--card-border); }
    .btn-prev:hover { background: rgba(255,255,255,0.1); }
    .btn-complete { background: linear-gradient(135deg, #d946ef, #c026d3); color: white; flex-grow: 1; }
    .btn-complete:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(217,70,239,0.6); }
    .btn-next { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
    .btn-next:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(102,126,234,0.6); }

    @media (max-width: 768px) { .navigation { flex-direction: column; } .model-container { height: 400px; } }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="/js/three-sensor-models.js"></script>

<div class="top-progress-container"><div class="top-progress-fill"></div></div>

<div class="container">
    <div class="glass-card lesson-header">
        <div class="meta-tags">
            <span class="tag">⏱️ 16 min read</span>
            <span class="tag">📈 Level: Intermediate</span>
            <span class="tag tag-accent">✨ 3D Interactive</span>
        </div>
        <h1>Soil pH Sensors</h1>
        <p style="color: var(--text-muted); font-size: 18px;">Master soil acidity measurement and learn how pH directly controls the availability of essential crop nutrients.</p>
    </div>

    <div class="glass-card content-area">
        <div id="model-viewer" class="model-container" data-sensor="ph">
            <div class="model-overlay">
                <div class="model-title">Glass Electrode pH Probe</div>
                <div class="model-hint">
                    <span class="hint-icon">🖱️ Drag to rotate</span>
                    <span class="hint-icon">⚙️ Scroll to zoom</span>
                    <span class="hint-icon">👆 Hover parts for info</span>
                </div>
            </div>
        </div>

        <h2>Understanding Soil pH</h2>
        <p>Soil pH measures acidity or alkalinity on a scale of 0 to 14. It is the single most important chemical property of soil because it dictates which nutrients are soluble and available for plant roots to absorb.</p>

        <div class="highlight-box">
            <strong>💡 Key Insight:</strong> At pH 6.5, almost all essential nutrients are highly available. If the pH drops to 5.0 (acidic), phosphorus becomes locked in the soil, while toxic levels of aluminum may be released.
        </div>

        <h2>The pH Scale</h2>
        <div class="ph-scale">
            <div class="ph-block" style="background:#ef4444;">4</div>
            <div class="ph-block" style="background:#f97316;">5</div>
            <div class="ph-block" style="background:#facc15;">6</div>
            <div class="ph-block" style="background:#4ade80;">7</div>
            <div class="ph-block" style="background:#06b6d4;">8</div>
            <div class="ph-block" style="background:#6366f1;">9</div>
            <div class="ph-block" style="background:#8b5cf6;">10</div>
        </div>
        <div class="ph-labels">
            <span>Highly Acidic</span>
            <span>Optimal (6.0 - 7.0)</span>
            <span>Highly Alkaline</span>
        </div>

        <h2>Correcting Soil pH</h2>
        <ul>
            <li><strong>Too Acidic (< 6.0):</strong> Apply agricultural lime (calcium carbonate) or wood ash. It takes months to fully react.</li>
            <li><strong>Too Alkaline (> 7.5):</strong> Apply elemental sulfur, iron sulfate, or organic matter (like peat moss).</li>
            <li><strong>Buffer Capacity:</strong> Clay soils require much more lime or sulfur to change pH compared to sandy soils because they resist change.</li>
        </ul>
    </div>

    <div class="navigation">
        <a href="/lesson/4" class="btn btn-prev">← Previous</a>
        <button class="btn btn-complete" onclick="completeLesson(5, this)">
            <span class="btn-text">✓ Mark as Complete</span>
        </button>
        <a href="/lesson/6" class="btn btn-next">Next Lesson →</a>
    </div>
</div>

<script>
    function completeLesson(lessonNumber, btn) {
        const btnText = btn.querySelector('.btn-text');
        btnText.innerText = 'Saving...';
        
        fetch(`/lesson/complete/${lessonNumber}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                btnText.innerText = 'Completed! 🎉';
                btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
                setTimeout(() => window.location.href = `/lesson/${lessonNumber + 1}`, 1000);
            })
            .catch(err => {
                console.error('Error:', err);
                btnText.innerText = 'Error saving';
            });
    }
</script>
{% endblock %}
