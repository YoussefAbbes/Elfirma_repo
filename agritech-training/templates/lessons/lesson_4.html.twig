{% extends "base.html.twig" %}

{% block title %}Lesson 4: Soil Temperature Sensors{% endblock %}

{% block body %}
<!-- Copy the same style block from Lesson 3 for consistency, or abstract it later. For now, inline to ensure it works identically. -->
<style>
    :root {
        --bg-dark: #0a0f1c;
        --card-bg: rgba(20, 27, 45, 0.6);
        --card-border: rgba(255, 255, 255, 0.05);
        --accent: #f59e0b; /* Orange for temperature */
        --accent-glow: rgba(245, 158, 11, 0.4);
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
        background: var(--bg-dark); 
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
    }
    
    h1, h2, h3 { font-family: 'Outfit', sans-serif; }

    .top-progress-container {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 4px;
        background: rgba(255,255,255,0.1);
        z-index: 1000;
    }
    .top-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #f59e0b, #ef4444);
        width: 44.44%; /* Lesson 4/9 */
        box-shadow: 0 0 10px var(--accent-glow);
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 60px 20px; }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        animation: fadeUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    
    .glass-card:nth-child(1) { animation-delay: 0.1s; }
    .glass-card:nth-child(2) { animation-delay: 0.2s; }
    .glass-card:nth-child(3) { animation-delay: 0.3s; }

    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .lesson-header h1 {
        font-size: 36px;
        margin-bottom: 15px;
        background: linear-gradient(135deg, #fff, #fde68a);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .meta-tags { display: flex; gap: 15px; margin-bottom: 20px; }
    .tag {
        background: rgba(255,255,255,0.05);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        color: var(--text-muted);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .tag-accent {
        background: rgba(245, 158, 11, 0.15);
        color: #fcd34d;
        border-color: rgba(245, 158, 11, 0.3);
    }

    .model-container {
        width: 100%;
        height: 600px;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        background: #050810;
        border: 1px solid var(--card-border);
        margin: 30px 0;
        box-shadow: inset 0 0 50px rgba(0,0,0,0.8);
    }

    .model-overlay {
        position: absolute;
        top: 20px; left: 20px;
        pointer-events: none;
    }
    .model-title {
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 24px;
        font-weight: 600;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }
    .model-hint {
        color: var(--text-muted);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 5px;
    }
    .hint-icon {
        background: rgba(255,255,255,0.1);
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 12px;
    }

    .content-area h2 { color: #fff; font-size: 24px; margin: 30px 0 15px; }
    .content-area p { color: var(--text-muted); margin-bottom: 15px; font-size: 16px; }
    .content-area ul { list-style: none; margin-bottom: 20px; }
    .content-area li {
        color: var(--text-muted);
        margin-bottom: 10px;
        padding-left: 24px;
        position: relative;
    }
    .content-area li::before {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--accent);
    }

    .highlight-box {
        background: linear-gradient(90deg, rgba(245,158,11,0.1), transparent);
        border-left: 4px solid var(--accent);
        padding: 20px;
        border-radius: 0 12px 12px 0;
        margin: 25px 0;
    }
    .highlight-box strong { color: #fff; }

    .data-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 25px 0;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--card-border);
    }
    .data-table th, .data-table td {
        padding: 16px 24px;
        text-align: left;
        border-bottom: 1px solid var(--card-border);
    }
    .data-table th { background: rgba(255,255,255,0.05); color: #fff; font-weight: 600; }
    .data-table tr:hover td { background: rgba(255,255,255,0.02); }
    .status-dot {
        display: inline-block;
        width: 8px; height: 8px;
        border-radius: 50%;
        margin-right: 8px;
    }

    .navigation { display: flex; justify-content: space-between; gap: 20px; margin-top: 40px; }
    .btn {
        padding: 16px 32px; border-radius: 12px; font-weight: 600; text-decoration: none;
        text-align: center; transition: all 0.3s; cursor: pointer; border: none; font-size: 16px;
    }
    .btn-prev { background: rgba(255,255,255,0.05); color: #fff; border: 1px solid var(--card-border); }
    .btn-prev:hover { background: rgba(255,255,255,0.1); }
    .btn-complete { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; flex-grow: 1; }
    .btn-complete:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(245,158,11,0.6); }
    .btn-next { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
    .btn-next:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(102,126,234,0.6); }

    .tooltip { position: relative; display: inline-block; border-bottom: 1px dotted var(--accent); cursor: help; color: #fff; }
    .tooltip .tooltiptext {
        visibility: hidden; width: 250px; background-color: #1e293b; color: #fff;
        text-align: left; border-radius: 8px; padding: 12px; position: absolute; z-index: 1;
        bottom: 125%; left: 50%; margin-left: -125px; opacity: 0; transition: opacity 0.3s; border: 1px solid var(--card-border);
    }
    .tooltip:hover .tooltiptext { visibility: visible; opacity: 1; }
    @media (max-width: 768px) { .navigation { flex-direction: column; } .model-container { height: 400px; } }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="/js/three-sensor-models.js"></script>

<div class="top-progress-container"><div class="top-progress-fill"></div></div>

<div class="container">
    <div class="glass-card lesson-header">
        <div class="meta-tags">
            <span class="tag">⏱️ 18 min read</span>
            <span class="tag">📈 Level: Intermediate</span>
            <span class="tag tag-accent">✨ 3D Interactive</span>
        </div>
        <h1>Soil Temperature Sensors</h1>
        <p style="color: var(--text-muted); font-size: 18px;">Understand how thermal dynamics impact root growth, seed germination, and nutrient absorption rates.</p>
    </div>

    <div class="glass-card content-area">
        <div id="model-viewer" class="model-container" data-sensor="temperature">
            <div class="model-overlay">
                <div class="model-title">Digital Thermal Probe</div>
                <div class="model-hint">
                    <span class="hint-icon">🖱️ Drag to rotate</span>
                    <span class="hint-icon">⚙️ Scroll to zoom</span>
                    <span class="hint-icon">👆 Hover parts for info</span>
                </div>
            </div>
        </div>

        <h2>Temperature's Role in Plant Growth</h2>
        <p>Soil temperature directly regulates <span class="tooltip">metabolic processes<span class="tooltiptext">Chemical reactions within the plant, including respiration and photosynthesis, which dictate growth speed.</span></span>. It dictates when seeds germinate, how fast roots grow, and the rate at which nutrients dissolve into soil water for absorption.</p>

        <div class="highlight-box">
            <strong>💡 Key Insight:</strong> At 15°C, phosphorus absorption drops drastically. If you apply phosphorus fertilizer in cold soil, the plant cannot absorb it, leading to wasted fertilizer and potential runoff.
        </div>

        <h2>Thermal Ranges & Crop Impact</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Temperature Range</th>
                    <th>Biological Impact</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>5°C - 10°C</strong></td>
                    <td><span class="status-dot" style="background:#3b82f6;"></span>Too cold for most crops. Root elongation stops.</td>
                </tr>
                <tr>
                    <td><strong>10°C - 20°C</strong></td>
                    <td><span class="status-dot" style="background:#10b981;"></span>Cool season crops (lettuce, peas) begin active growth.</td>
                </tr>
                <tr>
                    <td><strong>20°C - 30°C</strong></td>
                    <td><span class="status-dot" style="background:#f59e0b;"></span>Optimal for warm-season crops (tomatoes, corn).</td>
                </tr>
                <tr>
                    <td><strong>> 30°C</strong></td>
                    <td><span class="status-dot" style="background:#ef4444;"></span>Heat stress begins. Roots may die back.</td>
                </tr>
            </tbody>
        </table>

        <h2>Actionable Strategies</h2>
        <ul>
            <li><strong>Precision Planting:</strong> Use temperature data, not just the calendar date, to determine when to plant seeds.</li>
            <li><strong>Irrigation Timing:</strong> Water during the coolest part of the day to lower soil temperature during heatwaves.</li>
            <li><strong>Mulching:</strong> Apply mulch to buffer temperature extremes (keeps soil warmer in winter, cooler in summer).</li>
        </ul>
    </div>

    <div class="navigation">
        <a href="/lesson/3" class="btn btn-prev">← Previous</a>
        <button class="btn btn-complete" onclick="completeLesson(4, this)">
            <span class="btn-text">✓ Mark as Complete</span>
        </button>
        <a href="/lesson/5" class="btn btn-next">Next Lesson →</a>
    </div>
</div>

<script>
    function completeLesson(lessonNumber, btn) {
        const btnText = btn.querySelector('.btn-text');
        btnText.innerText = 'Saving...';
        
        fetch(`/lesson/complete/${lessonNumber}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                btnText.innerText = 'Completed! 🎉';
                btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
                setTimeout(() => window.location.href = `/lesson/${lessonNumber + 1}`, 1000);
            })
            .catch(err => {
                console.error('Error:', err);
                btnText.innerText = 'Error saving';
            });
    }
</script>
{% endblock %}
