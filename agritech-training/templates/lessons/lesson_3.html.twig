{% extends "base.html.twig" %}

{% block title %}Lesson 3: Soil Humidity Sensors{% endblock %}

{% block body %}
<style>
    :root {
        --bg-dark: #0a0f1c;
        --card-bg: rgba(20, 27, 45, 0.6);
        --card-border: rgba(255, 255, 255, 0.05);
        --accent: #48bb78;
        --accent-glow: rgba(72, 187, 120, 0.4);
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
        background: var(--bg-dark); 
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
    }
    
    h1, h2, h3 { font-family: 'Outfit', sans-serif; }

    /* Top Progress Bar */
    .top-progress-container {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 4px;
        background: rgba(255,255,255,0.1);
        z-index: 1000;
    }
    .top-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #667eea, #48bb78);
        width: 33.33%; /* Lesson 3/9 */
        box-shadow: 0 0 10px var(--accent-glow);
    }

    .container { max-width: 1200px; margin: 0 auto; padding: 60px 20px; }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        animation: fadeUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    
    .glass-card:nth-child(1) { animation-delay: 0.1s; }
    .glass-card:nth-child(2) { animation-delay: 0.2s; }
    .glass-card:nth-child(3) { animation-delay: 0.3s; }

    @keyframes fadeUp {
        to { opacity: 1; transform: translateY(0); }
    }

    .lesson-header h1 {
        font-size: 36px;
        margin-bottom: 15px;
        background: linear-gradient(135deg, #fff, #a5b4fc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .meta-tags { display: flex; gap: 15px; margin-bottom: 20px; }
    .tag {
        background: rgba(255,255,255,0.05);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        color: var(--text-muted);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .tag-accent {
        background: rgba(72, 187, 120, 0.15);
        color: #86efac;
        border-color: rgba(72, 187, 120, 0.3);
    }

    /* 3D Model Section */
    .model-container {
        width: 100%;
        height: 600px;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        background: #050810;
        border: 1px solid var(--card-border);
        margin: 30px 0;
        box-shadow: inset 0 0 50px rgba(0,0,0,0.8);
    }

    .model-overlay {
        position: absolute;
        top: 20px; left: 20px;
        pointer-events: none;
    }
    .model-title {
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 24px;
        font-weight: 600;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }
    .model-hint {
        color: var(--text-muted);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 5px;
    }
    .hint-icon {
        background: rgba(255,255,255,0.1);
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 12px;
    }

    /* Content Typography */
    .content-area h2 {
        color: #fff;
        font-size: 24px;
        margin: 30px 0 15px;
    }
    .content-area p {
        color: var(--text-muted);
        margin-bottom: 15px;
        font-size: 16px;
    }
    .content-area ul {
        list-style: none;
        margin-bottom: 20px;
    }
    .content-area li {
        color: var(--text-muted);
        margin-bottom: 10px;
        padding-left: 24px;
        position: relative;
    }
    .content-area li::before {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--accent);
    }

    /* Highlight Box */
    .highlight-box {
        background: linear-gradient(90deg, rgba(72,187,120,0.1), transparent);
        border-left: 4px solid var(--accent);
        padding: 20px;
        border-radius: 0 12px 12px 0;
        margin: 25px 0;
    }
    .highlight-box strong { color: #fff; }

    /* Interactive Accordion */
    .accordion {
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        margin-bottom: 15px;
        overflow: hidden;
    }
    .accordion-header {
        padding: 18px 24px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        color: #fff;
        transition: background 0.3s;
    }
    .accordion-header:hover { background: rgba(255,255,255,0.05); }
    .accordion-content {
        padding: 0 24px;
        max-height: 0;
        overflow: hidden;
        transition: all 0.4s ease-out;
        color: var(--text-muted);
    }
    .accordion.active .accordion-content {
        padding: 0 24px 24px;
        max-height: 500px;
    }
    .accordion.active .icon { transform: rotate(180deg); }
    .icon { transition: transform 0.3s; }

    /* Data Table */
    .data-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 25px 0;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--card-border);
    }
    .data-table th, .data-table td {
        padding: 16px 24px;
        text-align: left;
        border-bottom: 1px solid var(--card-border);
    }
    .data-table th {
        background: rgba(255,255,255,0.05);
        color: #fff;
        font-weight: 600;
    }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: rgba(255,255,255,0.02); }
    .status-dot {
        display: inline-block;
        width: 8px; height: 8px;
        border-radius: 50%;
        margin-right: 8px;
    }

    /* Knowledge Check */
    .knowledge-check {
        background: rgba(102, 126, 234, 0.1);
        border: 1px solid rgba(102, 126, 234, 0.3);
        border-radius: 16px;
        padding: 30px;
        margin: 40px 0;
    }
    .knowledge-check h3 { color: #a5b4fc; margin-bottom: 15px; display: flex; align-items: center; gap: 10px; }
    .options { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; }
    .option-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--card-border);
        padding: 15px 20px;
        border-radius: 8px;
        color: #fff;
        text-align: left;
        cursor: pointer;
        transition: all 0.2s;
    }
    .option-btn:hover { background: rgba(255,255,255,0.1); }
    .option-btn.correct { background: rgba(72, 187, 120, 0.2); border-color: #48bb78; }
    .option-btn.wrong { background: rgba(239, 68, 68, 0.2); border-color: #ef4444; }
    .feedback { margin-top: 15px; font-size: 14px; display: none; }

    /* Navigation */
    .navigation {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-top: 40px;
    }
    .btn {
        padding: 16px 32px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        border: none;
        font-family: 'Inter', sans-serif;
        font-size: 16px;
    }
    .btn-prev {
        background: rgba(255,255,255,0.05);
        color: #fff;
        border: 1px solid var(--card-border);
    }
    .btn-prev:hover { background: rgba(255,255,255,0.1); }
    
    .btn-complete {
        background: linear-gradient(135deg, #48bb78, #38a169);
        color: white;
        flex-grow: 1;
        position: relative;
        overflow: hidden;
    }
    .btn-complete:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -10px rgba(72,187,120,0.6);
    }
    
    .btn-next {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }
    .btn-next:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -10px rgba(102,126,234,0.6);
    }

    /* Tooltip */
    .tooltip {
        position: relative;
        display: inline-block;
        border-bottom: 1px dotted var(--accent);
        cursor: help;
        color: #fff;
    }
    .tooltip .tooltiptext {
        visibility: hidden;
        width: 250px;
        background-color: #1e293b;
        color: #fff;
        text-align: left;
        border-radius: 8px;
        padding: 12px;
        position: absolute;
        z-index: 1;
        bottom: 125%;
        left: 50%;
        margin-left: -125px;
        opacity: 0;
        transition: opacity 0.3s;
        font-size: 13px;
        border: 1px solid var(--card-border);
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    .tooltip:hover .tooltiptext {
        visibility: visible;
        opacity: 1;
    }

    @media (max-width: 768px) {
        .navigation { flex-direction: column; }
        .model-container { height: 400px; }
    }
</style>

<!-- Load Three.js safely from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="/js/three-sensor-models.js"></script>

<div class="top-progress-container">
    <div class="top-progress-fill"></div>
</div>

<div class="container">
    <div class="glass-card lesson-header">
        <div class="meta-tags">
            <span class="tag">⏱️ 18 min read</span>
            <span class="tag">📈 Level: Intermediate</span>
            <span class="tag tag-accent">✨ 3D Interactive</span>
        </div>
        <h1>Soil Humidity Sensors</h1>
        <p style="color: var(--text-muted); font-size: 18px;">Master capacitive moisture measurement and data-driven irrigation to maximize crop yield while conserving water.</p>
    </div>

    <div class="glass-card content-area">
        <!-- 3D Viewer -->
        <div id="model-viewer" class="model-container" data-sensor="humidity">
            <div class="model-overlay">
                <div class="model-title">Capacitive Humidity Probe</div>
                <div class="model-hint">
                    <span class="hint-icon">🖱️ Drag to rotate</span>
                    <span class="hint-icon">⚙️ Scroll to zoom</span>
                    <span class="hint-icon">👆 Hover parts for info</span>
                </div>
            </div>
        </div>

        <h2>Understanding Capacitive Measurement</h2>
        <p>Unlike resistive sensors which corrode quickly, modern SmartFarm humidity sensors use <span class="tooltip">capacitive measurement<span class="tooltiptext">Measures the dielectric permittivity of a surrounding medium. Water has a much higher dielectric constant than soil.</span></span>. The sensor emits an electromagnetic field into the soil, and measures the returning frequency which changes based on the volume of water present.</p>

        <div class="highlight-box">
            <strong>💡 Pro Tip:</strong> Always install sensors at the active root zone depth (typically 15-30cm). Surface moisture evaporates quickly and isn't representative of what the plant can access.
        </div>

        <h2>Humidity Ranges & Action Matrix</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Moisture %</th>
                    <th>Status</th>
                    <th>Action Required</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0% - 20%</td>
                    <td><span class="status-dot" style="background:#ef4444;"></span>Critical Dry</td>
                    <td>Immediate heavy irrigation required.</td>
                </tr>
                <tr>
                    <td>21% - 40%</td>
                    <td><span class="status-dot" style="background:#f59e0b;"></span>Sub-optimal</td>
                    <td>Schedule irrigation within 24 hours.</td>
                </tr>
                <tr>
                    <td>41% - 60%</td>
                    <td><span class="status-dot" style="background:#10b981;"></span>Optimal</td>
                    <td>No action. Ideal condition for nutrient uptake.</td>
                </tr>
                <tr>
                    <td>61% - 100%</td>
                    <td><span class="status-dot" style="background:#3b82f6;"></span>Saturated</td>
                    <td>Halt irrigation. Risk of fungal disease and root rot.</td>
                </tr>
            </tbody>
        </table>

        <h2>Advanced Placement Strategies</h2>
        
        <div class="accordion">
            <div class="accordion-header" onclick="this.parentElement.classList.toggle('active')">
                <span>📍 Zonal Placement Strategy</span>
                <span class="icon">▼</span>
            </div>
            <div class="accordion-content">
                <br>
                Divide your field into management zones based on soil type and topography. Place at least one sensor in each distinct zone. A sandy area will drain much faster than a clay area, requiring entirely different irrigation schedules.
            </div>
        </div>

        <div class="accordion">
            <div class="accordion-header" onclick="this.parentElement.classList.toggle('active')">
                <span>📏 Multi-depth Monitoring</span>
                <span class="icon">▼</span>
            </div>
            <div class="accordion-content">
                <br>
                For deep-rooted crops, install sensors at multiple depths (e.g., 15cm, 30cm, and 60cm) in the same location. This shows how quickly water penetrates the soil profile and helps prevent over-watering that pushes nutrients past the root zone.
            </div>
        </div>

        <!-- Inline Quiz -->
        <div class="knowledge-check">
            <h3>🧠 Quick Knowledge Check</h3>
            <p>Why are capacitive sensors preferred over resistive sensors for permanent agricultural installations?</p>
            <div class="options">
                <button class="option-btn" onclick="checkAnswer(this, false)">A. They are cheaper to manufacture.</button>
                <button class="option-btn" onclick="checkAnswer(this, true)">B. They don't expose metal directly to soil, preventing rapid corrosion.</button>
                <button class="option-btn" onclick="checkAnswer(this, false)">C. They draw less power from the battery.</button>
            </div>
            <div id="quiz-feedback" class="feedback"></div>
        </div>
    </div>

    <div class="navigation">
        <a href="/lesson/2" class="btn btn-prev">← Previous</a>
        <button id="complete-btn" class="btn btn-complete" onclick="completeLesson(3, this)">
            <span class="btn-text">✓ Mark as Complete</span>
        </button>
        <a href="/lesson/4" class="btn btn-next">Next Lesson →</a>
    </div>
</div>

<!-- Confetti Canvas -->
<canvas id="confetti" style="position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:9999;"></canvas>

<script>
    // Quiz Logic
    function checkAnswer(btn, isCorrect) {
        const parent = btn.parentElement;
        const feedback = document.getElementById('quiz-feedback');
        
        // Reset others
        Array.from(parent.children).forEach(b => {
            b.classList.remove('correct', 'wrong');
            b.style.pointerEvents = 'none';
        });

        if (isCorrect) {
            btn.classList.add('correct');
            feedback.style.color = '#48bb78';
            feedback.innerHTML = '<strong>Correct!</strong> Capacitive sensors use an insulated probe, meaning no metal touches the wet soil, preventing the galvanic corrosion that destroys resistive sensors in weeks.';
        } else {
            btn.classList.add('wrong');
            feedback.style.color = '#ef4444';
            feedback.innerHTML = '<strong>Not quite.</strong> The main advantage is longevity. Exposed metal in wet soil acts like a battery and corrodes rapidly.';
            
            // Highlight correct
            parent.children[1].classList.add('correct');
        }
        feedback.style.display = 'block';
    }

    // Completion Logic with Confetti
    function completeLesson(lessonNumber, btn) {
        const btnText = btn.querySelector('.btn-text');
        btnText.innerText = 'Saving...';
        
        fetch(`/lesson/complete/${lessonNumber}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                btnText.innerText = 'Completed! 🎉';
                btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
                fireConfetti();
                setTimeout(() => {
                    window.location.href = `/lesson/${lessonNumber + 1}`;
                }, 2000);
            })
            .catch(err => {
                console.error('Error:', err);
                btnText.innerText = 'Error saving';
            });
    }

    // Simple Confetti
    function fireConfetti() {
        const canvas = document.getElementById('confetti');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        
        const particles = [];
        const colors = ['#48bb78', '#667eea', '#f59e0b', '#a5b4fc', '#ffffff'];
        
        for(let i=0; i<100; i++) {
            particles.push({
                x: canvas.width/2,
                y: canvas.height/2 + 100,
                vx: (Math.random()-0.5) * 20,
                vy: (Math.random()-1) * 20 - 5,
                size: Math.random() * 8 + 4,
                color: colors[Math.floor(Math.random() * colors.length)],
                rot: Math.random() * Math.PI
            });
        }
        
        function animate() {
            ctx.clearRect(0,0,canvas.width,canvas.height);
            let active = false;
            
            particles.forEach(p => {
                p.vy += 0.5; // gravity
                p.x += p.vx;
                p.y += p.vy;
                p.rot += 0.1;
                
                if (p.y < canvas.height) active = true;
                
                ctx.save();
                ctx.translate(p.x, p.y);
                ctx.rotate(p.rot);
                ctx.fillStyle = p.color;
                ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size);
                ctx.restore();
            });
            
            if(active) requestAnimationFrame(animate);
        }
        animate();
    }
</script>
{% endblock %}
