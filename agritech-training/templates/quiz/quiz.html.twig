{% extends "base.html.twig" %}

{% block title %}Exam - SmartFarm Training{% endblock %}

{% block body %}
<style>
    :root {
        --bg-dark: #0a0f1c;
        --card-bg: rgba(20, 27, 45, 0.6);
        --card-border: rgba(255, 255, 255, 0.05);
        --accent: #667eea;
        --accent-glow: rgba(102, 126, 234, 0.4);
        --success: #10b981;
        --error: #ef4444;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
        background: var(--bg-dark); 
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
    }
    h1, h2, h3 { font-family: 'Outfit', sans-serif; }

    .container { max-width: 900px; margin: 40px auto; padding: 0 20px; }

    .glass-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        margin-bottom: 30px;
    }

    .quiz-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .quiz-header h1 { font-size: 28px; color: #fff; }

    .timer {
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--card-border);
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        color: #fbbf24;
    }

    .progress-bar-bg {
        background: rgba(255,255,255,0.1);
        height: 8px;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 15px;
    }

    .progress-fill {
        background: linear-gradient(90deg, #667eea, #764ba2);
        height: 100%;
        transition: width 0.3s ease;
        box-shadow: 0 0 10px var(--accent-glow);
    }

    .progress-text { font-size: 14px; color: var(--text-muted); text-align: right; }

    .question { font-size: 22px; color: #fff; margin-bottom: 30px; line-height: 1.4; }

    .options { display: flex; flex-direction: column; gap: 15px; }

    .option { position: relative; }
    .option input[type="radio"] { position: absolute; opacity: 0; width: 0; height: 0; }
    .option-label {
        display: block;
        padding: 20px;
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 16px;
        color: var(--text-muted);
    }
    
    .option input[type="radio"]:checked + .option-label {
        background: rgba(102, 126, 234, 0.15);
        border-color: #667eea;
        color: #fff;
        box-shadow: inset 0 0 20px rgba(102, 126, 234, 0.2);
    }

    .option-label:hover { background: rgba(255,255,255,0.05); color: #fff; }

    .navigation { display: flex; justify-content: space-between; margin-top: 40px; }
    .btn {
        padding: 15px 30px; border-radius: 12px; font-weight: 600; border: none; cursor: pointer;
        transition: all 0.3s; font-size: 16px;
    }
    .btn-prev { background: rgba(255,255,255,0.05); color: #fff; border: 1px solid var(--card-border); }
    .btn-prev:hover:not(:disabled) { background: rgba(255,255,255,0.1); }
    .btn-next { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
    .btn-submit { background: linear-gradient(135deg, #10b981, #059669); color: white; }
    .btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 20px -10px var(--accent-glow); }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    /* Result Section */
    .result { display: none; text-align: center; }
    .result.show { display: block; animation: fadeUp 0.8s ease-out forwards; }
    
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .result-icon { font-size: 80px; margin-bottom: 20px; }
    .result-icon.pass { filter: drop-shadow(0 0 20px rgba(16,185,129,0.4)); }
    .result-icon.fail { filter: drop-shadow(0 0 20px rgba(239,68,68,0.4)); }

    .score-display {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white; padding: 30px; border-radius: 20px;
        margin: 30px auto; font-size: 64px; font-weight: 800;
        font-family: 'Outfit', sans-serif;
        display: inline-block;
        min-width: 250px;
        box-shadow: 0 15px 30px -10px rgba(102, 126, 234, 0.5);
    }

    .result-details {
        background: rgba(255,255,255,0.02); border: 1px solid var(--card-border);
        padding: 25px; border-radius: 16px; margin-bottom: 30px;
        text-align: left; max-width: 500px; margin-left: auto; margin-right: auto;
    }
    .result-details p { margin: 10px 0; color: var(--text-muted); display: flex; justify-content: space-between; border-bottom: 1px dashed rgba(255,255,255,0.1); padding-bottom: 10px; }
    .result-details p strong { color: #fff; }

    .btn-dl { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; padding: 15px 30px; border-radius: 12px; font-weight: 600; margin: 10px; }
    .btn-dl:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(245,158,11,0.5); }

</style>

<div class="container">
    <div id="quizApp">
        <div class="glass-card">
            <div class="quiz-header">
                <h1>Final Exam</h1>
                <div class="timer">⏱️ <span id="timer">30:00</span></div>
            </div>

            <div class="progress-bar-bg">
                <div class="progress-fill" id="progressBar" style="width: 0%"></div>
            </div>
            <div class="progress-text">
                Question <span id="currentQuestion">1</span> of <span id="totalQuestions">30</span>
            </div>
        </div>

        <form id="quizForm">
            <div id="quizContainer" class="glass-card">
                <!-- Questions injected here -->
            </div>
        </form>
    </div>

    <div id="resultContainer" class="glass-card result">
        <div class="result-icon" id="resultIcon">✅</div>
        <h2 id="resultTitle" style="color:#fff; font-size:32px; margin-bottom:10px;">Congratulations!</h2>
        <p id="resultMessage" style="color:var(--text-muted); font-size:18px; margin-bottom:20px;"></p>
        
        <div class="score-display" id="scoreDisplay">85%</div>
        
        <div class="result-details" id="resultDetails"></div>
        
        <div id="actionButtons">
            <!-- Buttons injected here based on pass/fail -->
        </div>
    </div>
</div>

<!-- Confetti Canvas for Passing -->
<canvas id="confetti" style="position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:9999; display:none;"></canvas>

<script>
const PASSING_SCORE = 70; // Updated to 70%
let quizData = [];
let currentQuestionIndex = 0;
let answers = {};
let quizStartTime = Date.now();

async function loadQuestions() {
    try {
        const response = await fetch('/quiz/api/questions');
        quizData = await response.json();
        document.getElementById('totalQuestions').textContent = quizData.length;
        renderQuestion();
        startTimer();
    } catch (error) {
        console.error('Failed to load questions:', error);
    }
}

function renderQuestion() {
    const question = quizData[currentQuestionIndex];
    const html = `
        <div style="font-size: 13px; color: var(--accent); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;">Question ${currentQuestionIndex + 1}</div>
        <h2 class="question">${question.question}</h2>
        <div class="options">
            ${question.options.map((option, idx) => `
                <div class="option">
                    <input type="radio" id="option${idx}" name="question_${question.id}" value="${option}"
                        ${answers[question.id] === option ? 'checked' : ''}>
                    <label for="option${idx}" class="option-label">${option}</label>
                </div>
            `).join('')}
        </div>
        <div class="navigation">
            <button type="button" class="btn btn-prev" onclick="previousQuestion()" ${currentQuestionIndex === 0 ? 'disabled' : ''}>← Previous</button>
            ${currentQuestionIndex === quizData.length - 1
                ? `<button type="button" class="btn btn-submit" onclick="submitQuiz()">Submit Exam</button>`
                : `<button type="button" class="btn btn-next" onclick="nextQuestion()">Next →</button>`
            }
        </div>
    `;
    document.getElementById('quizContainer').innerHTML = html;
    document.getElementById('currentQuestion').textContent = currentQuestionIndex + 1;
    document.getElementById('progressBar').style.width = ((currentQuestionIndex + 1) / quizData.length * 100) + '%';

    const selectedRadio = document.querySelector(`input[name="question_${question.id}"]:checked`);
    if (selectedRadio) answers[question.id] = selectedRadio.value;
}

function nextQuestion() {
    const question = quizData[currentQuestionIndex];
    const selectedRadio = document.querySelector(`input[name="question_${question.id}"]:checked`);
    if (!selectedRadio) { alert('Please select an answer before proceeding'); return; }
    answers[question.id] = selectedRadio.value;
    currentQuestionIndex++;
    renderQuestion();
}

function previousQuestion() {
    const question = quizData[currentQuestionIndex];
    const selectedRadio = document.querySelector(`input[name="question_${question.id}"]:checked`);
    if (selectedRadio) answers[question.id] = selectedRadio.value;
    currentQuestionIndex--;
    renderQuestion();
}

async function submitQuiz() {
    const question = quizData[currentQuestionIndex];
    const selectedRadio = document.querySelector(`input[name="question_${question.id}"]:checked`);
    if (!selectedRadio) { alert('Please select an answer'); return; }
    answers[question.id] = selectedRadio.value;

    const btn = document.querySelector('.btn-submit');
    if (btn) { btn.disabled = true; btn.innerText = "Submitting..."; }

    // Prompt for name for certificate
    let userName = prompt("Please enter your full name as you would like it to appear on your certificate:") || 'Student';

    try {
        const response = await fetch('/quiz/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                userId: 1, // Assume logged in user
                userName: userName,
                answers: answers
            })
        });

        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const result = await response.json();
        showResult(result);
    } catch (error) {
        console.error('Failed to submit quiz:', error);
        alert('Error submitting quiz. Please try again.');
        if (btn) { btn.disabled = false; btn.innerText = "Submit Exam"; }
    }
}

function showResult(result) {
    const passed = result.passed;
    const score = result.score;
    const icon = document.getElementById('resultIcon');

    document.getElementById('scoreDisplay').textContent = score + '%';

    if (passed) {
        icon.textContent = '🏆';
        icon.className = 'result-icon pass';
        document.getElementById('resultTitle').textContent = 'Congratulations!';
        document.getElementById('resultMessage').innerHTML = `You passed the exam! Your official certificate has been generated and saved.`;
        fireConfetti();
    } else {
        icon.textContent = '📚';
        icon.className = 'result-icon fail';
        document.getElementById('resultTitle').textContent = 'Keep Learning';
        document.getElementById('resultMessage').innerHTML = `You need ${PASSING_SCORE}% to pass. Review the lessons and try again.`;
    }

    document.getElementById('resultDetails').innerHTML = `
        <p>Your Score: <strong>${score}%</strong></p>
        <p>Passing Score: <strong>${PASSING_SCORE}%</strong></p>
        <p>Status: <strong style="color: ${passed ? 'var(--success)' : 'var(--error)'}">${passed ? 'PASSED' : 'NOT PASSED'}</strong></p>
        ${result.certificateNumber ? `<p>Certificate ID: <strong>${result.certificateNumber}</strong></p>` : ''}
    `;

    let actionsHtml = `<a href="/dashboard" class="btn btn-prev" style="text-decoration:none; display:inline-block; margin: 10px;">Return to Dashboard</a>`;
    if (result.certificateNumber) {
        // Assume userId = 1 for this prototype
        actionsHtml += `<a href="/certificate/1/download" class="btn-dl">📄 Download PDF Certificate</a>`;
    }

    document.getElementById('actionButtons').innerHTML = actionsHtml;
    
    document.getElementById('quizApp').style.display = 'none';
    document.getElementById('resultContainer').classList.add('show');
}

function startTimer() {
    const endTime = quizStartTime + (30 * 60 * 1000);
    setInterval(() => {
        const now = Date.now();
        const remaining = Math.max(0, endTime - now);
        const minutes = Math.floor(remaining / 60000);
        const seconds = Math.floor((remaining % 60000) / 1000);
        document.getElementById('timer').textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
    }, 1000);
}

function fireConfetti() {
    const canvas = document.getElementById('confetti');
    canvas.style.display = 'block';
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth; canvas.height = window.innerHeight;
    const particles = [];
    const colors = ['#10b981', '#667eea', '#f59e0b', '#d946ef', '#ffffff'];
    for(let i=0; i<150; i++) {
        particles.push({
            x: canvas.width/2, y: canvas.height/2 + 100,
            vx: (Math.random()-0.5) * 25, vy: (Math.random()-1) * 25 - 5,
            size: Math.random() * 8 + 4, color: colors[Math.floor(Math.random() * colors.length)], rot: Math.random() * Math.PI
        });
    }
    function animate() {
        ctx.clearRect(0,0,canvas.width,canvas.height);
        let active = false;
        particles.forEach(p => {
            p.vy += 0.5; p.x += p.vx; p.y += p.vy; p.rot += 0.1;
            if (p.y < canvas.height) active = true;
            ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);
            ctx.fillStyle = p.color; ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size); ctx.restore();
        });
        if(active) requestAnimationFrame(animate);
    }
    animate();
}

loadQuestions();
</script>
{% endblock %}
