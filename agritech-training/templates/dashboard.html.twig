{% extends "base.html.twig" %}

{% block title %}Training Dashboard - AgriTech{% endblock %}

{% block body %}
<style>
    :root {
        --bg-dark: #0a0f1c;
        --card-bg: rgba(20, 27, 45, 0.6);
        --card-border: rgba(255, 255, 255, 0.05);
        --accent-green: #48bb78;
        --accent-purple: #764ba2;
        --accent-blue: #667eea;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: var(--bg-dark);
        background-image: 
            radial-gradient(circle at 15% 50%, rgba(102, 126, 234, 0.15) 0%, transparent 50%),
            radial-gradient(circle at 85% 30%, rgba(118, 75, 162, 0.15) 0%, transparent 50%);
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
        color: var(--text-main);
    }

    h1, h2, h3 {
        font-family: 'Outfit', sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 20px;
    }

    .glass-panel {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .header-dashboard {
        padding: 40px;
        margin-bottom: 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
        animation: fadeInDown 0.8s ease-out;
    }

    @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .header-content h1 {
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 12px;
        background: linear-gradient(135deg, #fff, #a5b4fc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .header-content p {
        color: var(--text-muted);
        font-size: 18px;
        max-width: 500px;
        line-height: 1.6;
    }

    /* Circular Progress */
    .progress-ring-container {
        position: relative;
        width: 120px;
        height: 120px;
    }

    .progress-ring {
        transform: rotate(-90deg);
    }

    .progress-ring__circle-bg {
        fill: none;
        stroke: rgba(255,255,255,0.1);
        stroke-width: 8;
    }

    .progress-ring__circle {
        fill: none;
        stroke: url(#gradient);
        stroke-width: 8;
        stroke-linecap: round;
        stroke-dasharray: 314;
        stroke-dashoffset: 314; /* 100% = 0, 0% = 314 */
        animation: fillProgress 1.5s ease-out forwards 0.5s;
    }

    /* Adjust dashoffset based on 11% completion (314 - (314 * 0.11) = 279.46) */
    @keyframes fillProgress {
        to { stroke-dashoffset: 279.46; } 
    }

    .progress-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        font-family: 'Outfit', sans-serif;
    }

    .progress-text .num {
        font-size: 28px;
        font-weight: 800;
        color: #fff;
    }

    .progress-text .label {
        font-size: 12px;
        color: var(--accent-green);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Lesson Grid */
    .lessons-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
        margin-bottom: 60px;
    }

    .lesson-card {
        padding: 30px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        opacity: 0;
        animation: fadeInUp 0.6s ease-out forwards;
    }

    /* Staggered animations for cards */
    .lesson-card:nth-child(1) { animation-delay: 0.1s; }
    .lesson-card:nth-child(2) { animation-delay: 0.2s; }
    .lesson-card:nth-child(3) { animation-delay: 0.3s; }
    .lesson-card:nth-child(4) { animation-delay: 0.4s; }
    .lesson-card:nth-child(5) { animation-delay: 0.5s; }
    .lesson-card:nth-child(6) { animation-delay: 0.6s; }
    .lesson-card:nth-child(7) { animation-delay: 0.7s; }
    .lesson-card:nth-child(8) { animation-delay: 0.8s; }
    .lesson-card:nth-child(9) { animation-delay: 0.9s; }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .lesson-card:hover {
        transform: translateY(-10px) scale(1.02);
        border-color: rgba(102, 126, 234, 0.4);
        box-shadow: 0 30px 60px -15px rgba(102, 126, 234, 0.2);
    }

    /* Card Glowing effect on hover */
    .lesson-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--accent-blue), var(--accent-purple), transparent);
        opacity: 0;
        transition: opacity 0.4s;
    }

    .lesson-card:hover::before {
        opacity: 1;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .lesson-number {
        background: linear-gradient(135deg, rgba(102,126,234,0.2), rgba(118,75,162,0.2));
        color: #a5b4fc;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 20px;
        border: 1px solid rgba(102,126,234,0.3);
    }

    .lesson-badge {
        background: rgba(255,255,255,0.1);
        color: #e2e8f0;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .badge-3d {
        background: rgba(72, 187, 120, 0.15);
        color: #86efac;
        border: 1px solid rgba(72, 187, 120, 0.3);
    }
    
    .badge-ai {
        background: rgba(118, 75, 162, 0.15);
        color: #d8b4fe;
        border: 1px solid rgba(118, 75, 162, 0.3);
    }

    .lesson-card h3 {
        color: #fff;
        font-size: 20px;
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .lesson-description {
        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 20px;
        flex-grow: 1;
    }

    .lesson-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
    }

    .duration {
        color: #64748b;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-start {
        background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
        color: white;
        padding: 10px 24px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }

    .btn-start:hover {
        box-shadow: 0 0 20px rgba(102, 126, 234, 0.5);
        filter: brightness(1.1);
    }

    .status-completed .lesson-number {
        background: rgba(72, 187, 120, 0.2);
        color: #86efac;
        border-color: rgba(72, 187, 120, 0.4);
    }

    .status-completed .btn-start {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.2);
        color: #cbd5e1;
    }
    .status-completed .btn-start:hover {
        background: rgba(255,255,255,0.05);
        box-shadow: none;
    }

    /* Quiz Section */
    .quiz-section {
        padding: 50px;
        text-align: center;
        background: linear-gradient(135deg, rgba(20, 27, 45, 0.8), rgba(10, 15, 28, 0.9));
        position: relative;
        overflow: hidden;
    }

    .quiz-section::after {
        content: '';
        position: absolute;
        top: -50%; left: -50%; width: 200%; height: 200%;
        background: radial-gradient(circle, rgba(72, 187, 120, 0.1) 0%, transparent 60%);
        pointer-events: none;
    }

    .quiz-icon {
        font-size: 64px;
        margin-bottom: 20px;
        filter: drop-shadow(0 0 20px rgba(72,187,120,0.4));
    }

    .quiz-section h2 {
        font-size: 32px;
        color: #fff;
        margin-bottom: 15px;
    }

    .quiz-section p {
        color: var(--text-muted);
        font-size: 16px;
        margin-bottom: 30px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .quiz-stats {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin-bottom: 40px;
    }

    .stat-badge {
        background: rgba(255,255,255,0.05);
        padding: 12px 24px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .stat-badge .value {
        color: #fff;
        font-size: 20px;
        font-weight: 700;
        font-family: 'Outfit', sans-serif;
    }

    .stat-badge .label {
        color: var(--text-muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-quiz {
        background: linear-gradient(135deg, #48bb78, #38a169);
        color: white;
        padding: 18px 40px;
        border-radius: 12px;
        font-size: 18px;
        font-weight: 700;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        box-shadow: 0 15px 30px -10px rgba(72, 187, 120, 0.4);
    }

    .btn-quiz:hover {
        transform: translateY(-3px);
        box-shadow: 0 20px 40px -10px rgba(72, 187, 120, 0.6);
        filter: brightness(1.1);
    }

    @media (max-width: 768px) {
        .header-dashboard {
            flex-direction: column;
            text-align: center;
            padding: 30px 20px;
        }
        .quiz-stats {
            flex-direction: column;
            gap: 15px;
        }
    }
</style>

<div class="container">
    <div class="glass-panel header-dashboard">
        <div class="header-content">
            <h1>Welcome to SmartFarm Training</h1>
            <p>Master precision agriculture with interactive 3D sensors, AI models, and real-world farm data. Complete all lessons to earn your certification.</p>
        </div>
        <div class="progress-ring-container">
            <svg class="progress-ring" width="120" height="120">
                <defs>
                    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#667eea" />
                        <stop offset="100%" stop-color="#764ba2" />
                    </linearGradient>
                </defs>
                <circle class="progress-ring__circle-bg" cx="60" cy="60" r="50"></circle>
                <circle class="progress-ring__circle" cx="60" cy="60" r="50"></circle>
            </svg>
            <div class="progress-text">
                <div class="num">1<span style="font-size: 16px; color: #64748b;">/9</span></div>
                <div class="label">Done</div>
            </div>
        </div>
    </div>

    <div class="lessons-grid">
        <!-- Lesson 1 (Completed State) -->
        <div class="lesson-card glass-panel status-completed">
            <div class="card-header">
                <div class="lesson-number">✓</div>
                <div class="lesson-badge">Theory</div>
            </div>
            <h3>Introduction to Smart Agriculture</h3>
            <p class="lesson-description">Overview of precision agriculture principles and the SmartFarm platform architecture.</p>
            <div class="lesson-footer">
                <div class="duration">⏱️ 15 min</div>
                <a href="/lesson/1" class="btn-start">Review</a>
            </div>
        </div>

        <!-- Lesson 2 -->
        <div class="lesson-card glass-panel">
            <div class="card-header">
                <div class="lesson-number">2</div>
                <div class="lesson-badge">App</div>
            </div>
            <h3>Using the Mobile Application</h3>
            <p class="lesson-description">Learn how to navigate dashboards, configure alerts, and utilize camera features.</p>
            <div class="lesson-footer">
                <div class="duration">⏱️ 20 min</div>
                <a href="/lesson/2" class="btn-start">Start Lesson</a>
            </div>
        </div>

        <!-- Lesson 3 -->
        <div class="lesson-card glass-panel">
            <div class="card-header">
                <div class="lesson-number">3</div>
                <div class="lesson-badge badge-3d">3D Interactive</div>
            </div>
            <h3>Soil Humidity Sensors</h3>
            <p class="lesson-description">Deep dive into capacitive moisture measurement and irrigation optimization.</p>
            <div class="lesson-footer">
                <div class="duration">⏱️ 18 min</div>
                <a href="/lesson/3" class="btn-start">Start Lesson</a>
            </div>
        </div>

        <!-- Lesson 4 -->
        <div class="lesson-card glass-panel">
            <div class="card-header">
                <div class="lesson-number">4</div>
                <div class="lesson-badge badge-3d">3D Interactive</div>
            </div>
            <h3>Soil Temperature Sensors</h3>
            <p class="lesson-description">Understand thermal impact on root growth and nutrient absorption rates.</p>
            <div class="lesson-footer">
                <div class="duration">⏱️ 18 min</div>
                <a href="/lesson/4" class="btn-start">Start Lesson</a>
            </div>
        </div>

        <!-- Lesson 5 -->
        <div class="lesson-card glass-panel">
            <div class="card-header">
                <div class="lesson-number">5</div>
                <div class="lesson-badge badge-3d">3D Interactive</div>
            </div>
            <h3>Soil pH Sensors</h3>
            <p class="lesson-description">Learn about soil acidity, glass electrode calibration, and pH correction.</p>
            <div class="lesson-footer">
                <div class="duration">⏱️ 16 min</div>
                <a href="/lesson/5" class="btn-start">Start Lesson</a>
            </div>
        </div>

        <!-- Lesson 6 -->
        <div class="lesson-card glass-panel">
            <div class="card-header">
                <div class="lesson-number">6</div>
                <div class="lesson-badge badge-3d">3D Interactive</div>
            </div>
            <h3>NPK Sensors</h3>
            <p class="lesson-description">Master macronutrient monitoring (Nitrogen, Phosphorus, Potassium) for fertilizer management.</p>
            <div class="lesson-footer">
                <div class="duration">⏱️ 20 min</div>
                <a href="/lesson/6" class="btn-start">Start Lesson</a>
            </div>
        </div>

        <!-- Lesson 7 -->
        <div class="lesson-card glass-panel">
            <div class="card-header">
                <div class="lesson-number">7</div>
                <div class="lesson-badge badge-ai">AI Analysis</div>
            </div>
            <h3>Plant Disease Detection</h3>
            <p class="lesson-description">Use computer vision AI to instantly identify crop diseases from leaf photos.</p>
            <div class="lesson-footer">
                <div class="duration">⏱️ 22 min</div>
                <a href="/lesson/7" class="btn-start">Start Lesson</a>
            </div>
        </div>

        <!-- Lesson 8 -->
        <div class="lesson-card glass-panel">
            <div class="card-header">
                <div class="lesson-number">8</div>
                <div class="lesson-badge badge-ai">AI Analysis</div>
            </div>
            <h3>Understanding AI Recommendations</h3>
            <p class="lesson-description">Decode machine learning outputs for predictive yield and automated irrigation.</p>
            <div class="lesson-footer">
                <div class="duration">⏱️ 18 min</div>
                <a href="/lesson/8" class="btn-start">Start Lesson</a>
            </div>
        </div>

        <!-- Lesson 9 -->
        <div class="lesson-card glass-panel">
            <div class="card-header">
                <div class="lesson-number">9</div>
                <div class="lesson-badge">Hardware</div>
            </div>
            <h3>Maintenance & Troubleshooting</h3>
            <p class="lesson-description">Best practices for sensor cleaning, battery replacement, and network debugging.</p>
            <div class="lesson-footer">
                <div class="duration">⏱️ 15 min</div>
                <a href="/lesson/9" class="btn-start">Start Lesson</a>
            </div>
        </div>
    </div>

    <!-- Quiz Section -->
    <div class="glass-panel quiz-section">
        <div class="quiz-icon">🏆</div>
        <h2>Certification Exam</h2>
        <p>Put your knowledge to the test. Pass the final exam to generate your official, verifiable SmartFarm Certificate.</p>
        
        <div class="quiz-stats">
            <div class="stat-badge">
                <span class="value">30</span>
                <span class="label">Questions</span>
            </div>
            <div class="stat-badge">
                <span class="value">30m</span>
                <span class="label">Time Limit</span>
            </div>
            <div class="stat-badge">
                <span class="value">80%</span>
                <span class="label">Passing Score</span>
            </div>
        </div>

        <a href="/quiz" class="btn-quiz">Take the Exam</a>
    </div>
</div>
{% endblock %}
